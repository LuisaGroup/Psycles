From cb168525138fecc792cc393f94afc39582b0103c Mon Sep 17 00:00:00 2001
From: Mike Smith <mango@live.cn>
Date: Wed, 5 Aug 2026 22:36:09 +0800
Subject: [PATCH] Cycles: add Psycles per-path trace oracle

---
 intern/cycles/kernel/data_template.h          |   3 +
 .../kernel/integrator/init_from_camera.h      |  38 +-
 .../cycles/kernel/integrator/psycles_trace.h  | 295 ++++++++++++
 intern/cycles/kernel/integrator/shade_light.h |  31 +-
 .../cycles/kernel/integrator/shade_shadow.h   |   7 +
 .../cycles/kernel/integrator/shade_surface.h  | 451 +++++++++++++++++-
 intern/cycles/kernel/light/sample.h           |  37 +-
 intern/cycles/kernel/light/triangle.h         |  13 +-
 intern/cycles/scene/integrator.cpp            |   1 +
 intern/cycles/scene/light.cpp                 |  39 ++
 10 files changed, 888 insertions(+), 27 deletions(-)
 create mode 100644 intern/cycles/kernel/integrator/psycles_trace.h

diff --git a/intern/cycles/kernel/data_template.h b/intern/cycles/kernel/data_template.h
index 24e094df3..8dce065b8 100644
--- a/intern/cycles/kernel/data_template.h
+++ b/intern/cycles/kernel/data_template.h
@@ -198,6 +198,9 @@ KERNEL_STRUCT_MEMBER(integrator, float, differential_widen_scale)
 /* Seed. */
 KERNEL_STRUCT_MEMBER_DONT_SPECIALIZE
 KERNEL_STRUCT_MEMBER(integrator, int, seed)
+/* Diagnostic sample captured by the Psycles path-trace oracle. */
+KERNEL_STRUCT_MEMBER_DONT_SPECIALIZE
+KERNEL_STRUCT_MEMBER(integrator, int, psycles_trace_sample)
 /* Clamp. */
 KERNEL_STRUCT_MEMBER(integrator, float, sample_clamp_direct)
 KERNEL_STRUCT_MEMBER(integrator, float, sample_clamp_indirect)
diff --git a/intern/cycles/kernel/integrator/init_from_camera.h b/intern/cycles/kernel/integrator/init_from_camera.h
index 948a83a74..fd7d0eac2 100644
--- a/intern/cycles/kernel/integrator/init_from_camera.h
+++ b/intern/cycles/kernel/integrator/init_from_camera.h
@@ -10,6 +10,7 @@
 #include "kernel/film/light_passes.h"
 
 #include "kernel/integrator/path_state.h"
+#include "kernel/integrator/psycles_trace.h"
 
 #include "kernel/integrator/state_util.h"
 #include "kernel/sample/pattern.h"
@@ -22,6 +23,8 @@ ccl_device_inline Spectrum integrate_camera_sample(KernelGlobals kg,
                                                    const int y,
                                                    const uint rng_pixel,
                                                    ccl_private Ray *ray,
+                                                   ccl_private float2 *rand_filter_out,
+                                                   ccl_private float3 *rand_time_lens_out,
                                                    ccl_private int &r_cache_miss)
 {
   /* Filter sampling. */
@@ -35,6 +38,8 @@ ccl_device_inline Spectrum integrate_camera_sample(KernelGlobals kg,
   const float3 rand_time_lens = (use_motionblur || use_dof || use_custom_cam) ?
                                     path_rng_3D(kg, rng_pixel, sample, PRNG_LENS_TIME) :
                                     zero_float3();
+  *rand_filter_out = rand_filter;
+  *rand_time_lens_out = rand_time_lens;
 
   /* We use x for time and y,z for lens because in practice with Sobol
    * sampling this seems to give better convergence when an object is
@@ -94,8 +99,11 @@ ccl_device bool integrator_init_from_camera(KernelGlobals kg,
 
   /* Generate camera ray. */
   Ray ray;
+  float2 trace_filter;
+  float3 trace_time_lens;
   int cache_miss = 0;
-  Spectrum T = integrate_camera_sample(kg, sample, x, y, rng_pixel, &ray, cache_miss);
+  Spectrum T = integrate_camera_sample(
+      kg, sample, x, y, rng_pixel, &ray, &trace_filter, &trace_time_lens, cache_miss);
   if (cache_miss) {
     if (tile != nullptr) {
       integrator_path_init(state, DEVICE_KERNEL_INTEGRATOR_INIT_FROM_CAMERA);
@@ -139,6 +147,34 @@ ccl_device bool integrator_init_from_camera(KernelGlobals kg,
     }
   }
 
+  if (sample == kernel_data.integrator.psycles_trace_sample) {
+    const float rng_low = float(rng_pixel & 0xffffu);
+    const float rng_high = float(rng_pixel >> 16);
+    psycles_trace_write(kg,
+                        state,
+                        render_buffer,
+                        PSYCLES_TRACE_GLOBAL_HEADER,
+                        make_float3(float(PSYCLES_TRACE_SCHEMA_VERSION), float(x), float(y)));
+    psycles_trace_write(kg,
+                        state,
+                        render_buffer,
+                        PSYCLES_TRACE_GLOBAL_RNG,
+                        make_float3(float(sample), rng_low, rng_high));
+    psycles_trace_write(kg,
+                        state,
+                        render_buffer,
+                        PSYCLES_TRACE_GLOBAL_FILTER,
+                        make_float3(trace_filter.x, trace_filter.y, 0.0f));
+    psycles_trace_write(kg, state, render_buffer, PSYCLES_TRACE_GLOBAL_LENS_TIME, trace_time_lens);
+    psycles_trace_write(kg, state, render_buffer, PSYCLES_TRACE_GLOBAL_RAY_P, ray.P);
+    psycles_trace_write(kg, state, render_buffer, PSYCLES_TRACE_GLOBAL_RAY_D, ray.D);
+    psycles_trace_write(kg,
+                        state,
+                        render_buffer,
+                        PSYCLES_TRACE_GLOBAL_RAY_RANGE,
+                        make_float3(ray.tmin, ray.tmax, ray.time));
+  }
+
   return true;
 }
 
diff --git a/intern/cycles/kernel/integrator/psycles_trace.h b/intern/cycles/kernel/integrator/psycles_trace.h
new file mode 100644
index 000000000..50a3bd03f
--- /dev/null
+++ b/intern/cycles/kernel/integrator/psycles_trace.h
@@ -0,0 +1,295 @@
+/* SPDX-FileCopyrightText: 2026 Psycles Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/*
+ * Diagnostic-only Cycles oracle used by Psycles.
+ *
+ * The trace is written into color AOVs so the exact same instrumentation can
+ * run on the CPU and GPU wavefront integrators. The companion Blender script
+ * creates all required AOVs and renders exactly one pixel at one sample.
+ * Writes only observe existing state and never request a new random dimension.
+ */
+
+#include "kernel/film/write.h"
+#include "kernel/integrator/path_state.h"
+
+CCL_NAMESPACE_BEGIN
+
+static constexpr int PSYCLES_TRACE_SCHEMA_VERSION = 3;
+static constexpr int PSYCLES_TRACE_GLOBAL_SLOTS = 8;
+static constexpr int PSYCLES_TRACE_EVENT_SLOTS = 72;
+static constexpr int PSYCLES_TRACE_SHADOW_EVENT_SLOTS = 8;
+static constexpr int PSYCLES_TRACE_FORWARD_EVENT_SLOTS = 4;
+static constexpr int PSYCLES_TRACE_MAX_EVENTS = 4;
+static constexpr int PSYCLES_TRACE_MAX_CLOSURES = 8;
+static constexpr int PSYCLES_TRACE_SHADOW_EVENT_BASE =
+    PSYCLES_TRACE_GLOBAL_SLOTS + PSYCLES_TRACE_EVENT_SLOTS * PSYCLES_TRACE_MAX_EVENTS;
+static constexpr int PSYCLES_TRACE_FORWARD_EVENT_BASE =
+    PSYCLES_TRACE_SHADOW_EVENT_BASE +
+    PSYCLES_TRACE_SHADOW_EVENT_SLOTS * PSYCLES_TRACE_MAX_EVENTS;
+static constexpr int PSYCLES_TRACE_AOV_COUNT =
+    PSYCLES_TRACE_FORWARD_EVENT_BASE +
+    PSYCLES_TRACE_FORWARD_EVENT_SLOTS * PSYCLES_TRACE_MAX_EVENTS;
+
+enum PsyclesTraceGlobalSlot {
+  PSYCLES_TRACE_GLOBAL_HEADER = 0,
+  PSYCLES_TRACE_GLOBAL_RNG = 1,
+  PSYCLES_TRACE_GLOBAL_FILTER = 2,
+  PSYCLES_TRACE_GLOBAL_LENS_TIME = 3,
+  PSYCLES_TRACE_GLOBAL_RAY_P = 4,
+  PSYCLES_TRACE_GLOBAL_RAY_D = 5,
+  PSYCLES_TRACE_GLOBAL_RAY_RANGE = 6,
+  PSYCLES_TRACE_GLOBAL_RESERVED = 7,
+};
+
+enum PsyclesTraceEventSlot {
+  PSYCLES_TRACE_EVENT_STATE_DEPTH = 0,
+  PSYCLES_TRACE_EVENT_STATE_LOBES = 1,
+  PSYCLES_TRACE_EVENT_STATE_VISIBILITY = 2,
+  PSYCLES_TRACE_EVENT_STATE_FLAGS = 3,
+  PSYCLES_TRACE_EVENT_THROUGHPUT = 4,
+  PSYCLES_TRACE_EVENT_RAY_P = 5,
+  PSYCLES_TRACE_EVENT_RAY_D = 6,
+  PSYCLES_TRACE_EVENT_RAY_RANGE = 7,
+  PSYCLES_TRACE_EVENT_ISECT_COORD = 8,
+  PSYCLES_TRACE_EVENT_ISECT_ID = 9,
+  PSYCLES_TRACE_EVENT_SURFACE_META = 10,
+  PSYCLES_TRACE_EVENT_SURFACE_P = 11,
+  PSYCLES_TRACE_EVENT_SURFACE_NG = 12,
+  PSYCLES_TRACE_EVENT_SURFACE_N = 13,
+  PSYCLES_TRACE_EVENT_RANDOM_SCALARS = 14,
+  PSYCLES_TRACE_EVENT_RANDOM_LIGHT = 15,
+  PSYCLES_TRACE_EVENT_RANDOM_BSDF = 16,
+  PSYCLES_TRACE_EVENT_LIGHT_META = 17,
+  PSYCLES_TRACE_EVENT_LIGHT_ID = 18,
+  PSYCLES_TRACE_EVENT_LIGHT_PDF = 19,
+  PSYCLES_TRACE_EVENT_LIGHT_D = 20,
+  PSYCLES_TRACE_EVENT_LIGHT_P = 21,
+  PSYCLES_TRACE_EVENT_LIGHT_NG = 22,
+  PSYCLES_TRACE_EVENT_LIGHT_EVAL = 23,
+  PSYCLES_TRACE_EVENT_CLOSURE_PICK = 24,
+  PSYCLES_TRACE_EVENT_CLOSURE_RANDOM = 25,
+  PSYCLES_TRACE_EVENT_CLOSURE_WEIGHT = 26,
+  PSYCLES_TRACE_EVENT_CLOSURE_N = 27,
+  PSYCLES_TRACE_EVENT_BSDF_META = 28,
+  PSYCLES_TRACE_EVENT_BSDF_WO = 29,
+  PSYCLES_TRACE_EVENT_BSDF_EVAL = 30,
+  PSYCLES_TRACE_EVENT_BSDF_ROUGHNESS_ETA = 31,
+  PSYCLES_TRACE_EVENT_POST_DEPTH = 32,
+  PSYCLES_TRACE_EVENT_POST_THROUGHPUT = 33,
+  PSYCLES_TRACE_EVENT_POST_RAY_P = 34,
+  PSYCLES_TRACE_EVENT_POST_RAY_D = 35,
+  PSYCLES_TRACE_EVENT_POST_FLAGS = 36,
+  PSYCLES_TRACE_EVENT_POST_MIS = 37,
+  PSYCLES_TRACE_EVENT_SURFACE_FLAGS = 38,
+  PSYCLES_TRACE_EVENT_POST_VISIBILITY = 39,
+  PSYCLES_TRACE_EVENT_LIGHT_SHADER = 40,
+  PSYCLES_TRACE_EVENT_NEE_BSDF = 41,
+  PSYCLES_TRACE_EVENT_NEE_DIFFUSE = 42,
+  PSYCLES_TRACE_EVENT_NEE_GLOSSY = 43,
+  PSYCLES_TRACE_EVENT_NEE_WEIGHTED_BSDF = 44,
+  PSYCLES_TRACE_EVENT_NEE_LIGHT_SHADER = 45,
+  PSYCLES_TRACE_EVENT_NEE_UNSHADOWED = 46,
+  PSYCLES_TRACE_EVENT_NEE_CONTRIBUTION = 47,
+  PSYCLES_TRACE_EVENT_CLOSURE_BASE = 48,
+};
+
+enum PsyclesTraceShadowEventSlot {
+  PSYCLES_TRACE_SHADOW_EVENT_RAY_P = 0,
+  PSYCLES_TRACE_SHADOW_EVENT_RAY_D = 1,
+  PSYCLES_TRACE_SHADOW_EVENT_RAY_RANGE = 2,
+  PSYCLES_TRACE_SHADOW_EVENT_SOURCE = 3,
+  PSYCLES_TRACE_SHADOW_EVENT_LIGHT = 4,
+  PSYCLES_TRACE_SHADOW_EVENT_HIT_ID = 5,
+  PSYCLES_TRACE_SHADOW_EVENT_HIT_COORD = 6,
+  PSYCLES_TRACE_SHADOW_EVENT_TRANSMITTANCE = 7,
+};
+
+enum PsyclesTraceForwardEventSlot {
+  PSYCLES_TRACE_FORWARD_EVENT_EMISSION = 0,
+  PSYCLES_TRACE_FORWARD_EVENT_POLICY = 1,
+  PSYCLES_TRACE_FORWARD_EVENT_MIS = 2,
+  PSYCLES_TRACE_FORWARD_EVENT_CONTRIBUTION = 3,
+};
+
+ccl_device_forceinline int psycles_trace_event_index(ConstIntegratorState state)
+{
+  const int rng_offset = INTEGRATOR_STATE(state, path, rng_offset);
+  return rng_offset / PRNG_BOUNCE_NUM - 1;
+}
+
+ccl_device_forceinline int psycles_trace_event_slot(ConstIntegratorState state,
+                                                    const int relative_slot)
+{
+  const int event = psycles_trace_event_index(state);
+  return PSYCLES_TRACE_GLOBAL_SLOTS + event * PSYCLES_TRACE_EVENT_SLOTS + relative_slot;
+}
+
+ccl_device_forceinline bool psycles_trace_active(KernelGlobals kg,
+                                                 ConstIntegratorState state,
+                                                 const int slot)
+{
+  return kernel_data.film.pass_aov_color != PASS_UNUSED &&
+         kernel_data.film.pass_stride >=
+             kernel_data.film.pass_aov_color + PSYCLES_TRACE_AOV_COUNT * 4 &&
+         INTEGRATOR_STATE(state, path, sample) == kernel_data.integrator.psycles_trace_sample &&
+         slot >= 0 && slot < PSYCLES_TRACE_AOV_COUNT;
+}
+
+ccl_device_forceinline void psycles_trace_write(KernelGlobals kg,
+                                                ConstIntegratorState state,
+                                                ccl_global float *ccl_restrict render_buffer,
+                                                const int slot,
+                                                const float3 value)
+{
+  if (render_buffer == nullptr || !psycles_trace_active(kg, state, slot)) {
+    return;
+  }
+  ccl_global float *buffer = film_pass_pixel_render_buffer(kg, state, render_buffer);
+  buffer += kernel_data.film.pass_aov_color + slot * 4;
+  buffer[0] = value.x;
+  buffer[1] = value.y;
+  buffer[2] = value.z;
+  buffer[3] = 1.0f;
+}
+
+ccl_device_forceinline void psycles_trace_write_event(KernelGlobals kg,
+                                                      ConstIntegratorState state,
+                                                      ccl_global float *ccl_restrict render_buffer,
+                                                      const int relative_slot,
+                                                      const float3 value)
+{
+  const int event = psycles_trace_event_index(state);
+  if (event < 0 || event >= PSYCLES_TRACE_MAX_EVENTS) {
+    return;
+  }
+  psycles_trace_write(kg,
+                      state,
+                      render_buffer,
+                      PSYCLES_TRACE_GLOBAL_SLOTS + event * PSYCLES_TRACE_EVENT_SLOTS +
+                          relative_slot,
+                      value);
+}
+
+ccl_device_forceinline void psycles_trace_write_event_at(KernelGlobals kg,
+                                                         ConstIntegratorState state,
+                                                         ccl_global float *ccl_restrict
+                                                             render_buffer,
+                                                         const int event,
+                                                         const int relative_slot,
+                                                         const float3 value)
+{
+  if (event < 0 || event >= PSYCLES_TRACE_MAX_EVENTS) {
+    return;
+  }
+  psycles_trace_write(kg,
+                      state,
+                      render_buffer,
+                      PSYCLES_TRACE_GLOBAL_SLOTS + event * PSYCLES_TRACE_EVENT_SLOTS +
+                          relative_slot,
+                      value);
+}
+
+ccl_device_forceinline void psycles_trace_write_shadow_event_from_main(
+    KernelGlobals kg,
+    ConstIntegratorState state,
+    ccl_global float *ccl_restrict render_buffer,
+    const int relative_slot,
+    const float3 value)
+{
+  const int event = psycles_trace_event_index(state);
+  if (event < 0 || event >= PSYCLES_TRACE_MAX_EVENTS) {
+    return;
+  }
+  psycles_trace_write(kg,
+                      state,
+                      render_buffer,
+                      PSYCLES_TRACE_SHADOW_EVENT_BASE +
+                          event * PSYCLES_TRACE_SHADOW_EVENT_SLOTS + relative_slot,
+                      value);
+}
+
+ccl_device_forceinline void psycles_trace_write_forward_event(
+    KernelGlobals kg,
+    ConstIntegratorState state,
+    ccl_global float *ccl_restrict render_buffer,
+    const int relative_slot,
+    const float3 value)
+{
+  const int event = psycles_trace_event_index(state);
+  if (event < 0 || event >= PSYCLES_TRACE_MAX_EVENTS) {
+    return;
+  }
+  psycles_trace_write(kg,
+                      state,
+                      render_buffer,
+                      PSYCLES_TRACE_FORWARD_EVENT_BASE +
+                          event * PSYCLES_TRACE_FORWARD_EVENT_SLOTS + relative_slot,
+                      value);
+}
+
+ccl_device_forceinline int psycles_trace_shadow_event_index(
+    ConstIntegratorShadowState state)
+{
+  const int rng_offset = INTEGRATOR_STATE(state, shadow_path, rng_offset);
+  return rng_offset / PRNG_BOUNCE_NUM - 1;
+}
+
+ccl_device_forceinline bool psycles_trace_shadow_active(KernelGlobals kg,
+                                                        ConstIntegratorShadowState state,
+                                                        const int slot)
+{
+  return kernel_data.film.pass_aov_color != PASS_UNUSED &&
+         kernel_data.film.pass_stride >=
+             kernel_data.film.pass_aov_color + PSYCLES_TRACE_AOV_COUNT * 4 &&
+         INTEGRATOR_STATE(state, shadow_path, sample) ==
+             kernel_data.integrator.psycles_trace_sample &&
+         slot >= 0 && slot < PSYCLES_TRACE_AOV_COUNT;
+}
+
+ccl_device_forceinline void psycles_trace_write_shadow(
+    KernelGlobals kg,
+    ConstIntegratorShadowState state,
+    ccl_global float *ccl_restrict render_buffer,
+    const int slot,
+    const float3 value)
+{
+  if (render_buffer == nullptr || !psycles_trace_shadow_active(kg, state, slot)) {
+    return;
+  }
+  ccl_global float *buffer = film_pass_pixel_render_buffer_shadow(kg, state, render_buffer);
+  buffer += kernel_data.film.pass_aov_color + slot * 4;
+  buffer[0] = value.x;
+  buffer[1] = value.y;
+  buffer[2] = value.z;
+  buffer[3] = 1.0f;
+}
+
+ccl_device_forceinline void psycles_trace_write_shadow_event(
+    KernelGlobals kg,
+    ConstIntegratorShadowState state,
+    ccl_global float *ccl_restrict render_buffer,
+    const int relative_slot,
+    const float3 value)
+{
+  const int event = psycles_trace_shadow_event_index(state);
+  if (event < 0 || event >= PSYCLES_TRACE_MAX_EVENTS) {
+    return;
+  }
+  psycles_trace_write_shadow(kg,
+                             state,
+                             render_buffer,
+                             PSYCLES_TRACE_GLOBAL_SLOTS +
+                                 event * PSYCLES_TRACE_EVENT_SLOTS + relative_slot,
+                             value);
+}
+
+ccl_device_forceinline float3 psycles_trace_uint32(const uint32_t value)
+{
+  return make_float3(float(value & 0xffffu), float(value >> 16), 0.0f);
+}
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/shade_light.h b/intern/cycles/kernel/integrator/shade_light.h
index 13da8c099..bb9d974ba 100644
--- a/intern/cycles/kernel/integrator/shade_light.h
+++ b/intern/cycles/kernel/integrator/shade_light.h
@@ -7,6 +7,7 @@
 #include "kernel/film/light_passes.h"
 
 #include "kernel/integrator/path_state.h"
+#include "kernel/integrator/psycles_trace.h"
 #include "kernel/integrator/state_flow.h"
 #include "kernel/light/light.h"
 #include "kernel/light/sample.h"
@@ -112,7 +113,10 @@ ccl_device void integrator_shade_light_forward(KernelGlobals kg,
    * scene geometry. */
 }
 
-ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShadowState state)
+ccl_device ShaderEvalResult integrate_light_nee(
+    KernelGlobals kg,
+    IntegratorShadowState state,
+    ccl_global float *ccl_restrict render_buffer)
 {
   /* Read intersection and ray. */
   Ray ray ccl_optional_struct_init;
@@ -201,6 +205,11 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
   /* Evaluate emission closures. */
   eval = (is_background) ? surface_shader_background(emission_sd) :
                            surface_shader_emission(emission_sd);
+  psycles_trace_write_shadow_event(kg,
+                                   state,
+                                   render_buffer,
+                                   PSYCLES_TRACE_EVENT_NEE_LIGHT_SHADER,
+                                   spectrum_to_rgb(eval));
 
   /* Probabilistic light termination.
    * Light threshold is only used without light tree. */
@@ -210,15 +219,31 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
     const float rand_terminate = path_state_rng_light_termination(kg, &rng_state);
     const float bsdf_eval_average = INTEGRATOR_STATE(state, shadow_path, bsdf_eval_average);
     if (light_sample_terminate(kg, eval, bsdf_eval_average, rand_terminate)) {
+      psycles_trace_write_shadow_event(kg,
+                                       state,
+                                       render_buffer,
+                                       PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+                                       zero_float3());
       return SHADER_EVAL_EMPTY;
     }
   }
   else if (is_zero(eval)) {
+    psycles_trace_write_shadow_event(kg,
+                                     state,
+                                     render_buffer,
+                                     PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+                                     zero_float3());
     return SHADER_EVAL_EMPTY;
   }
 
   /* Update throughput. */
   INTEGRATOR_STATE(state, shadow_path, throughput) *= eval;
+  psycles_trace_write_shadow_event(
+      kg,
+      state,
+      render_buffer,
+      PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+      spectrum_to_rgb(INTEGRATOR_STATE(state, shadow_path, throughput)));
 
   return SHADER_EVAL_OK;
 }
@@ -227,11 +252,11 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
  * shadow ray intersection. Only when the light has non-constant emission. */
 ccl_device void integrator_shade_light_nee(KernelGlobals kg,
                                            IntegratorShadowState state,
-                                           ccl_global float *ccl_restrict /*render_buffer*/)
+                                           ccl_global float *ccl_restrict render_buffer)
 {
   PROFILING_INIT(kg, PROFILING_SHADE_LIGHT_SETUP);
 
-  const ShaderEvalResult result = integrate_light_nee(kg, state);
+  const ShaderEvalResult result = integrate_light_nee(kg, state, render_buffer);
 
   if (result == SHADER_EVAL_CACHE_MISS) {
     integrator_shadow_path_cache_miss(state, DEVICE_KERNEL_INTEGRATOR_SHADE_LIGHT_NEE);
diff --git a/intern/cycles/kernel/integrator/shade_shadow.h b/intern/cycles/kernel/integrator/shade_shadow.h
index 23c77ce65..60a5db0ee 100644
--- a/intern/cycles/kernel/integrator/shade_shadow.h
+++ b/intern/cycles/kernel/integrator/shade_shadow.h
@@ -5,6 +5,7 @@
 #pragma once
 
 #include "kernel/integrator/guiding.h"
+#include "kernel/integrator/psycles_trace.h"
 #include "kernel/integrator/shade_volume.h"
 #include "kernel/integrator/surface_shader.h"
 #include "kernel/integrator/volume_stack.h"
@@ -290,6 +291,12 @@ ccl_device void integrator_shade_shadow(KernelGlobals kg,
     return;
   }
 
+  psycles_trace_write_shadow_event(
+      kg,
+      state,
+      render_buffer,
+      PSYCLES_TRACE_EVENT_NEE_CONTRIBUTION,
+      spectrum_to_rgb(INTEGRATOR_STATE(state, shadow_path, throughput)));
   guiding_record_direct_light(kg, state);
   film_write_direct_light(kg, state, render_buffer);
   integrator_shadow_path_terminate(state, DEVICE_KERNEL_INTEGRATOR_SHADE_SHADOW);
diff --git a/intern/cycles/kernel/integrator/shade_surface.h b/intern/cycles/kernel/integrator/shade_surface.h
index 8857cb63f..44a39b06b 100644
--- a/intern/cycles/kernel/integrator/shade_surface.h
+++ b/intern/cycles/kernel/integrator/shade_surface.h
@@ -5,6 +5,7 @@
 #pragma once
 
 #include "kernel/integrator/path_state.h"
+#include "kernel/integrator/psycles_trace.h"
 #include "kernel/integrator/surface_shader.h"
 
 #include "kernel/film/data_passes.h"
@@ -115,6 +116,25 @@ ccl_device_forceinline bool integrate_surface_holdout(KernelGlobals kg,
   return true;
