 #include "kernel/integrator/state_flow.h"
 #include "kernel/light/light.h"
 #include "kernel/light/sample.h"
@@ -112,7 +113,10 @@ ccl_device void integrator_shade_light_forward(KernelGlobals kg,
    * scene geometry. */
 }
 
-ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShadowState state)
+ccl_device ShaderEvalResult integrate_light_nee(
+    KernelGlobals kg,
+    IntegratorShadowState state,
+    ccl_global float *ccl_restrict render_buffer)
 {
   /* Read intersection and ray. */
   Ray ray ccl_optional_struct_init;
@@ -201,6 +205,11 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
   /* Evaluate emission closures. */
   eval = (is_background) ? surface_shader_background(emission_sd) :
                            surface_shader_emission(emission_sd);
+  psycles_trace_write_shadow_event(kg,
+                                   state,
+                                   render_buffer,
+                                   PSYCLES_TRACE_EVENT_NEE_LIGHT_SHADER,
+                                   spectrum_to_rgb(eval));
 
   /* Probabilistic light termination.
    * Light threshold is only used without light tree. */
@@ -210,15 +219,31 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
     const float rand_terminate = path_state_rng_light_termination(kg, &rng_state);
     const float bsdf_eval_average = INTEGRATOR_STATE(state, shadow_path, bsdf_eval_average);
     if (light_sample_terminate(kg, eval, bsdf_eval_average, rand_terminate)) {
+      psycles_trace_write_shadow_event(kg,
+                                       state,
+                                       render_buffer,
+                                       PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+                                       zero_float3());
       return SHADER_EVAL_EMPTY;
     }
   }
   else if (is_zero(eval)) {
+    psycles_trace_write_shadow_event(kg,
+                                     state,
+                                     render_buffer,
+                                     PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+                                     zero_float3());
     return SHADER_EVAL_EMPTY;
   }
 
   /* Update throughput. */
   INTEGRATOR_STATE(state, shadow_path, throughput) *= eval;
+  psycles_trace_write_shadow_event(
+      kg,
+      state,
+      render_buffer,
+      PSYCLES_TRACE_EVENT_NEE_UNSHADOWED,
+      spectrum_to_rgb(INTEGRATOR_STATE(state, shadow_path, throughput)));
 
   return SHADER_EVAL_OK;
 }
@@ -227,11 +252,11 @@ ccl_device ShaderEvalResult integrate_light_nee(KernelGlobals kg, IntegratorShad
  * shadow ray intersection. Only when the light has non-constant emission. */
 ccl_device void integrator_shade_light_nee(KernelGlobals kg,
                                            IntegratorShadowState state,
-                                           ccl_global float *ccl_restrict /*render_buffer*/)
+                                           ccl_global float *ccl_restrict render_buffer)
 {
   PROFILING_INIT(kg, PROFILING_SHADE_LIGHT_SETUP);
 
-  const ShaderEvalResult result = integrate_light_nee(kg, state);
+  const ShaderEvalResult result = integrate_light_nee(kg, state, render_buffer);
 
   if (result == SHADER_EVAL_CACHE_MISS) {
     integrator_shadow_path_cache_miss(state, DEVICE_KERNEL_INTEGRATOR_SHADE_LIGHT_NEE);
diff --git a/intern/cycles/kernel/integrator/shade_shadow.h b/intern/cycles/kernel/integrator/shade_shadow.h
